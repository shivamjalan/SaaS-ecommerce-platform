# =====================================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in real values.
# =====================================================

# Razorpay public key (used by the checkout script)
VITE_RAZORPAY_KEY=

# Optional: override the API base URL.
# Defaults to the Vite /api proxy in dev, and http://localhost:5000/api in prod.
VITE_API_URL=
