# =====================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in real values.
# =====================================================

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/saree-saas

# Secret used to sign JWTs
JWT_SECRET=change-me

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OpenAI-compatible AI provider (used for descriptions, insights, chatbot)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Frontend URL used in password-reset emails (no trailing slash)
FRONTEND_URL=http://localhost:5173

# SMTP for password-reset emails (Gmail app-password example).
# Enable 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it as EMAIL_PASS.
# If unset, the reset link is printed to the server console instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
